{
  "name": "pedagogen",
  "version": "0.1.0",
  "description": "PEDAGOGEN - Application Pédagogique",
  "author": "PEDAGOGEN",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --test tests/**/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "electron:prep": "node electron/prepare.js",
    "electron:dev": "electron electron/main.js",
    "electron:build": "next build && node electron/prepare.js && electron-builder --win",
    "electron:portable": "next build && node electron/prepare.js && electron-builder --win portable"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "ai": "^6.0.204",
    "ai-sdk-provider-opencode-sdk": "^3.0.6",
    "animejs": "^4.4.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "docx": "^9.7.1",
    "docx-preview": "^0.3.7",
    "jose": "^6.2.3",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.17.0",
    "marked": "^18.0.5",
    "next": "16.2.7",
    "pptxgenjs": "^4.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-dropzone": "^15.0.0",
    "react-hook-form": "^7.78.0",
    "react-hot-toast": "^2.6.0",
    "react-pdf": "^10.4.1",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.5.0",
    "eslint-config-next": "^16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.pedagogen.app",
    "productName": "PEDAGOGEN",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "asarUnpack": [
      ".next/standalone/**/*"
    ],
    "files": [
      "electron/**/*",
      ".next/standalone/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
